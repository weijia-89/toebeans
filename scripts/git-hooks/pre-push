#!/usr/bin/env bash
# toebeans pre-push hook — deterministic fast-path verification.
#
# Runs every check that CI enforces BEFORE the Gradle build job starts,
# so that "green locally → green on CI" is the expected outcome for the
# fast-path gates. Gradle tests are intentionally skipped here (they are
# run by scripts/verify_before_push.sh before opening a PR).
#
# RULES
# -----
# 1. Fitness functions (no-network, no-analytics, scheduler-purity, etc.)
# 2. AGENTS.md / CLAUDE.md parity
# 3. ktlintCheck + detekt across all modules
# 4. Vibe-dangerous calibration check (diff against origin/main)
#
# BYPASS
# ------
# `git push --no-verify` bypasses this hook.
# Set TOEBEANS_SKIP_PRE_PUSH=1 to skip permanently in this shell session.
#
# INSTALL
# -------
# This file lives at scripts/git-hooks/pre-push (tracked).
# Install by running: bash scripts/install-git-hooks.sh

set -euo pipefail

RED='\033[1;31m'
YEL='\033[1;33m'
GRN='\033[1;32m'
NC='\033[0m'

if [[ "${TOEBEANS_SKIP_PRE_PUSH:-0}" == "1" ]]; then
    echo -e "${YEL}toebeans pre-push:${NC} TOEBEANS_SKIP_PRE_PUSH=1 — skipping."
    exit 0
fi

REPO_ROOT=$(git rev-parse --show-toplevel)
cd "$REPO_ROOT"

FAILED=0

run_check() {
    local name="$1"
    shift
    echo ""
    echo "==> $name"
    if "$@"; then
        echo -e "  ${GRN}PASS${NC} — $name"
    else
        echo -e "  ${RED}FAIL${NC} — $name"
        FAILED=$((FAILED + 1))
    fi
}

# ---------------------------------------------------------------------------
# 1. Fitness functions (lint-class CI gates) — fast, bash-based
# ---------------------------------------------------------------------------
run_check "Fitness: no-network"            bash scripts/test_no_network.sh .
run_check "Fitness: no-analytics"          bash scripts/test_no_analytics.sh .
run_check "Fitness: scheduler-purity"      bash scripts/test_scheduler_purity.sh .
run_check "Fitness: permission-allowlist"  bash scripts/test_permission_allowlist.sh .
run_check "Fitness: no-PII-in-crash-log"   bash scripts/test_no_pii_in_crash_log.sh .
run_check "Fitness: no-em-dash-in-docs"    bash scripts/test_no_em_dash_in_docs.sh .
run_check "Fitness: no-duplicate-private-test-class-names" \
    bash scripts/test_no_duplicate_private_test_class_names.sh .
run_check "Fitness: AGENTS/CLAUDE parity"  bash scripts/agents_claude_parity.sh .

# ---------------------------------------------------------------------------
# 2. Vibe-dangerous check (local mirror of CI gate)
# ---------------------------------------------------------------------------
if git rev-parse --verify origin/main >/dev/null 2>&1; then
    BASE=$(git merge-base HEAD origin/main)
    run_check "Vibe-dangerous review gate (local)" \
        bash scripts/ci-vibe-dangerous-check.sh "$BASE" HEAD "$(git branch --show-current)"
else
    echo -e "  ${YEL}SKIP${NC} — origin/main not found; cannot run vibe-dangerous diff"
fi

# ---------------------------------------------------------------------------
# 3. Gradle lint — must match CI exactly
#    CI runs: ./gradlew ktlintCheck detekt
# ---------------------------------------------------------------------------
run_check "Gradle lint (ktlint + detekt)" ./gradlew ktlintCheck detekt --console=plain

# ---------------------------------------------------------------------------
# Summary
# ---------------------------------------------------------------------------
echo ""
if [[ "$FAILED" -eq 0 ]]; then
    echo -e "${GRN}toebeans pre-push: OK${NC} — fast-path gates green. Safe to push."
    echo "  Run \`bash scripts/verify_before_push.sh\` before opening a PR"
    echo "  to also run Gradle tests (shared JVM + Android unit tests)."
    exit 0
else
    echo -e "${RED}toebeans pre-push: BLOCKED${NC} — $FAILED check(s) failed."
    echo "  Fix the failures above, or bypass with \`git push --no-verify\`."
    echo "  Bypassing risks a red CI build."
    exit 1
fi
